generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserSettings {
  userId   String @id
  currency String
}

model Category {
  createdAt   DateTime      @default(now())
  name        String
  userId      String?
  icon        String
  type        String        @default("income")
  id          String        @id @default(uuid())
  isUniversal Boolean       @default(false)
  tag         String?
  Transaction Transaction[]

  @@unique([name, userId, type])
}

model Transaction {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  amount      Float
  description String
  date        DateTime
  type        String   @default("income")
  userId      String
  categoryId  String
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "Transaction_categoryId_fkey")
}

model MonthHistory {
  userId  String
  day     Int
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([day, month, year, userId])
}

model YearHistory {
  userId  String
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([month, year, userId])
}
