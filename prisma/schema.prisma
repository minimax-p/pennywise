generator client {
  provider      = "prisma-client-js"
  // The Docker image runs on Debian bookworm
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserSettings {
  userId   String @id
  currency String
}

model Category {
  createdAt   DateTime      @default(now())
  name        String
  userId      String?
  icon        String
  type        String        @default("income")
  id          String        @id @default(uuid())
  isUniversal Boolean       @default(false)
  tag         String?
  Transaction Transaction[]

  @@unique([name, userId, type])
}

model Transaction {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  amount      Float
  description String
  date        DateTime
  type        String   @default("income")
  userId      String
  categoryId  String
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])

  // Set when the transaction was imported from a linked bank account
  plaidTransactionId String?    @unique
  plaidItemId        String?
  plaidItem          PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)

  // Where the money came from (for transfers) or went in or out of
  accountId    String?
  account      Account?      @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)
  // Transfers only: the account the money went to
  toAccountId  String?
  toAccount    Account?      @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: SetNull)
  // How it was entered: manual, import, apple_pay or plaid
  source       String        @default("manual")
  // Normalized merchant name, used to suggest a category from past transactions
  payeeKey     String?
  importedRows ImportedRow[]

  @@index([categoryId], map: "Transaction_categoryId_fkey")
  @@index([userId, date])
  @@index([userId, payeeKey])
}

model Account {
  id                String        @id @default(uuid())
  userId            String
  name              String
  // checking, savings, credit or cash
  type              String
  institution       String?
  // A balance the user entered and when it was true. The current balance adds
  // the transactions dated after it, so older imports don't shift it.
  knownBalance      Float         @default(0)
  knownBalanceDate  DateTime      @default(now())
  // Card name as Apple Wallet shows it, used to file Apple Pay purchases
  walletCardName    String?
  // Column mapping remembered from the last CSV import
  importSettings    Json?
  archived          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transactions      Transaction[] @relation("AccountTransactions")
  incomingTransfers Transaction[] @relation("TransferDestination")
  importedRows      ImportedRow[]

  @@unique([userId, name])
}

// One line of an imported bank statement. Lets re-imports skip lines already
// imported (even if the transaction was deleted since), and lets a transfer be
// matched from both accounts' statements.
model ImportedRow {
  id            String       @id @default(uuid())
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  // FITID from OFX/QFX files or an id column, otherwise a hash of the line
  fingerprint   String
  createdAt     DateTime     @default(now())

  @@unique([accountId, fingerprint])
}

// Device keys for the Apple Pay shortcut. Only a SHA-256 hash is stored.
model CaptureToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PlaidItem {
  id              String        @id @default(uuid())
  userId          String
  itemId          String        @unique
  // Encrypted with PLAID_TOKEN_ENCRYPTION_KEY, see lib/crypto.ts
  accessToken     String        @db.Text
  institutionId   String?
  institutionName String?
  // Position in the /transactions/sync stream
  cursor          String?       @db.Text
  // Plaid error code from the last failed sync, e.g. ITEM_LOGIN_REQUIRED
  error           String?
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  transactions    Transaction[]

  @@index([userId])
}

model MonthHistory {
  userId  String
  day     Int
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([day, month, year, userId])
}

model YearHistory {
  userId  String
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([month, year, userId])
}
