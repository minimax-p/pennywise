generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserSettings {
  userId   String @id
  currency String
}

model Category {
  createdAt   DateTime      @default(now())
  name        String
  userId      String?
  icon        String
  type        String        @default("income")
  id          String        @id @default(uuid())
  isUniversal Boolean       @default(false)
  tag         String?
  Transaction Transaction[]

  @@unique([name, userId, type])
}

model Transaction {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  amount      Float
  description String
  date        DateTime
  type        String   @default("income")
  userId      String
  categoryId  String
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])

  // Set when the transaction was imported from a linked bank account
  plaidTransactionId String?    @unique
  plaidItemId        String?
  plaidItem          PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)

  @@index([categoryId], map: "Transaction_categoryId_fkey")
  @@index([userId, date])
}

model PlaidItem {
  id              String        @id @default(uuid())
  userId          String
  itemId          String        @unique
  // Encrypted with PLAID_TOKEN_ENCRYPTION_KEY, see lib/crypto.ts
  accessToken     String        @db.Text
  institutionId   String?
  institutionName String?
  // Position in the /transactions/sync stream
  cursor          String?       @db.Text
  // Plaid error code from the last failed sync, e.g. ITEM_LOGIN_REQUIRED
  error           String?
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  transactions    Transaction[]

  @@index([userId])
}

model MonthHistory {
  userId  String
  day     Int
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([day, month, year, userId])
}

model YearHistory {
  userId  String
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([month, year, userId])
}
