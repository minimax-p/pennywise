generator client {
  provider      = "prisma-client-js"
  // Built on your computer and run on an Ubuntu 22.04+ server (OpenSSL 3)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserSettings {
  userId    String  @id
  currency  String
  // Your name as banks print it, comma separated, e.g. "HUU NHAT MINH PHAM".
  // Zelle payments to or from it are moves between your own accounts.
  selfNames String?
}

model Category {
  createdAt   DateTime      @default(now())
  name        String
  userId      String?
  icon        String
  type        String        @default("income")
  id          String        @id @default(uuid())
  isUniversal Boolean       @default(false)
  tag         String?
  Transaction Transaction[]
  lines       TransactionLine[]
  rules       Rule[]

  @@unique([name, userId, type])
}

model Transaction {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  amount      Float
  description String
  date        DateTime
  // income, expense, transfer or adjustment. Whether money counts as spending or
  // income follows the category: money back in a spending category is a refund.
  type        String   @default("income")
  userId      String
  categoryId  String
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])

  // Set when the transaction was imported from a linked bank account
  plaidTransactionId String?    @unique
  plaidItemId        String?
  plaidItem          PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)

  // Zelle memo, Venmo note, statement memo or your own note
  note        String?  @db.VarChar(500)
  // The name to show instead of the bank's description, when you or a rule renamed it.
  // Without one, statement lines show a cleaned-up description (lib/merchant.ts).
  merchant    String?
  // Who was on the other end: the Zelle or Venmo counterparty, or someone you picked
  personId    String?
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  // A split: your shares by category and other people's shares, adding up to the amount.
  // A split transaction is filed under the built-in Split category.
  lines       TransactionLine[]

  // Where the money came from (for transfers and adjustments out) or went in or out of
  accountId          String?
  account            Account?      @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)
  // Transfers and adjustments in: the account the money went to
  toAccountId        String?
  toAccount          Account?      @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: SetNull)
  // How it was entered: manual, import, apple_pay or plaid
  source             String        @default("manual")
  // Normalized merchant name, used to suggest a category from past transactions
  payeeKey           String?
  // Shown on the Sort page until you confirm or change the category
  needsReview        Boolean       @default(false)
  // Where the category came from: you, history, bank, keyword, ai or plaid.
  // Only your own choices (and older rows without a value) teach future suggestions.
  categorizedBy      String?
  // Jev's confidence in the category it picked, from 0 to 1
  categoryConfidence Float?
  // Jev's most likely categories, [{name, probability}], offered as one-tap choices
  aiSuggestions      Json?
  importedRows       ImportedRow[]

  @@index([categoryId])
  @@index([accountId])
  @@index([toAccountId])
  @@index([plaidItemId])
  @@index([personId])
  @@index([userId, date])
  @@index([userId, payeeKey])
  @@index([userId, needsReview])
}

model Account {
  id                String        @id @default(uuid())
  userId            String
  name              String
  // checking, savings, cd, credit, cash (bills and coins) or wallet (Venmo, PayPal, Cash App)
  type              String
  institution       String?
  // CDs only: yearly rate in percent and the day it matures
  apy               Float?
  maturesOn         DateTime?
  // Card name as Apple Wallet shows it, used to file Apple Pay purchases
  walletCardName    String?
  // Column mapping remembered from the last CSV import
  importSettings    Json?
  archived          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transactions      Transaction[] @relation("AccountTransactions")
  incomingTransfers Transaction[] @relation("TransferDestination")
  importedRows      ImportedRow[]
  balanceChecks     BalanceCheck[]

  @@unique([userId, name])
}

// A balance the bank showed, typed in or read from a statement. An account's balance
// is its latest check plus the transactions dated after it, so importing older
// statements never shifts it. Each check also verifies that the transactions since
// the check before it add up to the bank's change in balance.
model BalanceCheck {
  id        String   @id @default(uuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // When the balance was true: now for a balance checked today, the end of the day
  // for a past day. Transactions dated after it are added on top.
  date      DateTime
  // Negative when money is owed, as on a credit card
  balance   Float
  // you or statement
  source    String
  createdAt DateTime @default(now())

  @@index([accountId, date])
}

// One line of an imported bank statement. Lets re-imports skip lines already
// imported (even if the transaction was deleted since), and lets a transfer be
// matched from both accounts' statements.
model ImportedRow {
  id            String       @id @default(uuid())
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  // FITID from OFX/QFX files or an id column, otherwise a hash of the line
  fingerprint   String
  createdAt     DateTime     @default(now())

  @@unique([accountId, fingerprint])
  @@index([transactionId])
}

// Device keys for the Apple Pay shortcut. Only a SHA-256 hash is stored.
model CaptureToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PlaidItem {
  id              String        @id @default(uuid())
  userId          String
  itemId          String        @unique
  // Encrypted with PLAID_TOKEN_ENCRYPTION_KEY, see lib/crypto.ts
  accessToken     String        @db.Text
  institutionId   String?
  institutionName String?
  // Position in the /transactions/sync stream
  cursor          String?       @db.Text
  // Plaid error code from the last failed sync, e.g. ITEM_LOGIN_REQUIRED
  error           String?
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  transactions    Transaction[]

  @@index([userId])
}

// Someone you send money to or get money from. People come from Zelle and Venmo lines, or
// from splitting a bill. What they owe you is the sum of their split shares: shares of money
// you paid count up, shares of money you got (them paying you back) count down.
model Person {
  id           String            @id @default(uuid())
  userId       String
  name         String
  // How banks write the name, in capitals, e.g. "ALEX NGUYEN" from "Zelle payment from ALEX NGUYEN"
  aliases      String[]          @default([])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions Transaction[]
  lines        TransactionLine[]
  rules        Rule[]

  @@unique([userId, name])
}

// One part of a split transaction: your share in a category, or another person's share
model TransactionLine {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Positive; a transaction's lines add up to its amount
  amount        Float
  // Exactly one of the two
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  personId      String?
  person        Person?     @relation(fields: [personId], references: [id], onDelete: Restrict)
  position      Int         @default(0)

  @@index([transactionId])
  @@index([categoryId])
  @@index([personId])
}

// "Walmart is Groceries", "Description contains NETFLIX: Subscriptions", "Zelle to Dana Park is
// Rent". Rules sort new transactions before anything else, the same way every time and
// without leaving your server. Made with one tap on the Sort page, or on Manage.
model Rule {
  id         String    @id @default(uuid())
  userId     String
  // merchant: the same merchant as `pattern` (a payee key, see lib/payee.ts)
  // contains: the description contains `pattern`, ignoring case
  // person:   money to or from `personId`
  kind       String
  pattern    String?
  personId   String?
  person     Person?   @relation(fields: [personId], references: [id], onDelete: Cascade)
  // income or expense; null for both
  direction  String?
  // What the rule does: file under a category, show under a name, or both
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rename     String?
  // How the rule reads in lists, e.g. "Walmart"
  label      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}
