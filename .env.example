# MySQL connection string used by Prisma
DATABASE_URL="mysql://user:password@localhost:3306/pennywise"

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=sandbox
# Comma separated country codes offered in Plaid Link
PLAID_COUNTRY_CODES=US
# 32 byte key used to encrypt Plaid access tokens in the database.
# Generate with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=
