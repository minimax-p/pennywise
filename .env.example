# Copy to .env and fill in. The same file is used for local development and by docker-compose.yml.

# ---------- Login ----------
# Hash of your password. Generate it with: node scripts/hash-password.mjs
# (or on the server: docker compose run --rm migrate node scripts/hash-password.mjs)
PENNYWISE_PASSWORD_HASH=
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Optional: the name shown on the dashboard
PENNYWISE_NAME=
# Optional: keep data created when Pennywise used Clerk by putting that Clerk user id here
PENNYWISE_USER_ID=
# Your time zone, used for dates of Apple Pay purchases logged by the shortcut
TZ=America/New_York

# ---------- Database ----------
# Local development only; docker-compose.yml builds its own from DB_PASSWORD
DATABASE_URL="mysql://user:password@localhost:3306/pennywise"

# ---------- Docker deployment ----------
# Domain pointing at your server; Caddy gets an HTTPS certificate for it
DOMAIN=pennywise.example.com
# Use letters and digits only, e.g. openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------- Optional: Plaid bank sync ----------
# Leave empty to hide the Plaid section. See README.md.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
PLAID_TOKEN_ENCRYPTION_KEY=
